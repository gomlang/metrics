package metrics;

use std::context;
use std::math;
use std::text;

pub struct GaugeReading {
    pub name: string,
    pub labels: Labels,
    pub value: f64,
}

fn reading_key(name: string, labels: Vec[Label]) -> string {
    let key = text::StringBuilder::new();
    key.write_string(name.byte_len().to_string() + ":" + name);
    for label in labels {
        key.write_string(label.name.byte_len().to_string() + ":" + label.name);
        key.write_string(label.value.byte_len().to_string() + ":" + label.value);
    }
    key.finish()
}

impl Registry {
    pub fn collect_gauges(
        self: Registry,
        ctx: context::Context,
        collect: (context::Context) -> Result[Vec[GaugeReading], Error],
    ) -> Result[(), Error] {
        ctx.check().map_err(context_error)?;
        let readings = collect(ctx)?;
        self.acquire(ctx)?;
        defer self.unlock();
        if readings.len() > self.options.max_series {
            return Result::Err(error(ErrorKind::Limit, "collector batch exceeds series limit"))
        }
        let families: HashMap[string, Family] = HashMap::new();
        for family in self.families.get() {
            ctx.check().map_err(context_error)?;
            families.insert(family.descriptor.name, family);
        }
        let indexed: HashMap[string, HashMap[string, Cell]] = HashMap::new();
        let updates = Vec::new();
        let seen: HashMap[string, bool] = HashMap::new();
        for reading in readings {
            ctx.check().map_err(context_error)?;
            if !math::is_finite(reading.value) {
                return Result::Err(
                    error(ErrorKind::InvalidValue, "collector returned a nonfinite gauge"),
                )
            }
            let family = families.get(reading.name).ok_or(
                error(ErrorKind::Detached, "collector target series is not registered"),
            )?;
            if family.descriptor.kind != Kind::Gauge {
                return Result::Err(error(ErrorKind::Conflict, "collector target is not a gauge"))
            }
            let labels = self.labels(family.descriptor, reading.labels)?;
            let key = reading_key(reading.name, labels);
            if seen.get(key).is_some() {
                return Result::Err(
                    error(ErrorKind::Conflict, "collector returned a duplicate series"),
                )
            }
            seen.insert(key, true);
            let cells = match indexed.get(reading.name) {
                Some(cells) => cells,
                None => {
                    let cells: HashMap[string, Cell] = HashMap::new();
                    for cell in family.series.get() {
                        ctx.check().map_err(context_error)?;
                        cells.insert(reading_key(reading.name, cell.labels), cell);
                    }
                    indexed.insert(reading.name, cells);
                    cells
                },
            };
            let cell = cells.get(key).ok_or(
                error(ErrorKind::Detached, "collector target series is not registered"),
            )?;
            updates.push((cell, reading.value));
        }
        ctx.check().map_err(context_error)?;
        for (cell, value) in updates {
            cell.value.set(Value::Gauge(value));
        }
        Result::Ok(())
    }
}
