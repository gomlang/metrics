package tests;

use ecosystem::metrics;
use std::testing;

#[test]
fn reverse_registered_families_and_series_have_lexical_snapshot_order() -> () {
    let registry = testing::expect_ok(
        metrics::Registry::new(
            metrics::Options { max_series_per_family: 2048, ..metrics::Options::standard() },
        ),
        "registry",
    );
    let descriptor = metrics::Descriptor::gauge("series", "ordered").with_labels(
        Vec::from_array(["first", "second"]),
    );
    let keys = Vec::new();
    for index in 0..1024 {
        keys.push((10000 + index).to_string());
    }
    for index in 0..keys.len() {
        let key = keys[keys.len() - index - 1];
        let labels = testing::expect_ok(
            metrics::Labels::new(Vec::from_array([("first", key), ("second", "z")])),
            "labels",
        );
        testing::expect_ok(registry.gauge(descriptor, labels), "series");
    }
    for index in 0..64 {
        let name = "family_" + keys[63 - index];
        testing::assert_ok(registry.register(metrics::Descriptor::counter(name, "")));
    }
    let families = registry.snapshot().families();
    testing::assert_eq(families.len(), 65);
    for index in 0..64 {
        testing::assert_eq(families[index].descriptor.name, "family_" + keys[index]);
    }
    let series = families[64].samples;
    testing::assert_eq(series.len(), 1024);
    for index in 0..series.len() {
        testing::assert_eq(series[index].labels[0].value, keys[index]);
    }
    let labels = testing::expect_ok(
        metrics::Labels::new(Vec::from_array([("first", keys[0]), ("second", "a")])),
        "labels",
    );
    testing::expect_ok(registry.gauge(descriptor, labels), "secondary label");
    let changed = registry.snapshot().families()[64].samples;
    testing::assert_eq(changed[0].labels[1].value, "a");
    testing::assert_eq(changed[1].labels[1].value, "z");
    testing::assert_eq(series.len(), 1024);
}

#[test]
fn large_reverse_label_sets_normalize_names_without_losing_values_or_isolation() -> () {
    let count = 2048;
    let pairs = Vec::new();
    let names = Vec::new();
    for index in 0..count {
        let name = "label_" + (10000 + count - index - 1).to_string();
        let value = "值:" + index.to_string();
        pairs.push((name, value));
        names.push(name);
    }
    let labels = testing::expect_ok(metrics::Labels::new(pairs), "labels");
    testing::assert_eq(pairs[0].0, "label_12047");
    let entries = labels.entries();
    for index in 0..count {
        testing::assert_eq(entries[index].name, "label_" + (10000 + index).to_string());
        testing::assert_eq(entries[index].value, "值:" + (count - index - 1).to_string());
    }
    let registry = testing::expect_ok(
        metrics::Registry::new(
            metrics::Options { max_labels: count, ..metrics::Options::standard() },
        ),
        "registry",
    );
    let descriptor = metrics::Descriptor::counter("wide", "").with_labels(names);
    let counter = testing::expect_ok(registry.counter(descriptor, labels), "normalized schema");
    testing::assert_ok(counter.increment());
    let family = registry.snapshot().families()[0];
    for index in 0..count {
        testing::assert_eq(family.descriptor.label_names[index], entries[index].name);
    }
    pairs[0] = ("changed", "changed");
    entries[0] = metrics::Label { name: "changed", value: "changed" };
    names[0] = "changed";
    testing::assert_eq(labels.entries()[0].name, "label_10000");
    testing::assert_eq(descriptor.label_names[0], "label_12047");
    testing::assert_eq(family.samples[0].labels[count - 1].value, "值:0");
    let duplicates = pairs.copy();
    duplicates[count / 2] = duplicates[count - 1];
    testing::assert_eq(
        testing::expect_err(metrics::Labels::new(duplicates), "duplicate labels").kind,
        metrics::ErrorKind::InvalidLabels,
    );
    let duplicate_names = names.copy();
    duplicate_names[count / 2] = duplicate_names[count - 1];
    testing::assert_eq(
        testing::expect_err(
            registry.register(
                metrics::Descriptor::counter("duplicate", "").with_labels(duplicate_names),
            ),
            "duplicate schema",
        ).kind,
        metrics::ErrorKind::InvalidLabels,
    );
}
