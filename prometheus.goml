package metrics;

use std::text;
use std::io;
use io::Write;

pub fn content_type() -> string {
    "text/plain; version=0.0.4; charset=utf-8"
}

fn escaped(value: string, label: bool) -> string {
    let output = text::StringBuilder::new();
    for character in value.chars() {
        match character {
            '\\' => output.write_string("\\\\"),
            '\n' => output.write_string("\\n"),
            '"' if label => output.write_string("\\\""),
            _ => output.write_char(character),
        }
    }
    output.finish()
}

fn sample_labels(labels: Vec[Label], boundary: Option[string]) -> string {
    if labels.len() == 0 && boundary.is_none() {
        return ""
    }
    let output = text::StringBuilder::new();
    output.write_string("{");
    let mut first = true;
    for label in labels {
        if !first {
            output.write_string(",");
        }
        first = false;
        output.write_string(label.name + "=\"" + escaped(label.value, true) + "\"");
    }
    if let Some(boundary) = boundary {
        if !first {
            output.write_string(",");
        }
        output.write_string("le=\"" + boundary + "\"");
    }
    output.write_string("}");
    output.finish()
}

fn number(value: f64) -> string {
    if value == 0.0 {
        "0"
    } else {
        value.to_string()
    }
}

#[derive(Debug)]
pub enum ExportError {
    Limit,
    Io(io::Error),
}

impl ToString for ExportError {
    fn to_string(self: ExportError) -> string {
        match self {
            Limit => "Prometheus output exceeds byte limit",
            Io(problem) => problem.to_string(),
        }
    }
}

impl Snapshot {
    pub fn prometheus(self: Snapshot) -> string {
        let output = text::StringBuilder::new();
        let _ = self.emit_prometheus(
            |part| {
                output.write_string(part);
                Result::Ok(())
            },
        );
        output.finish()
    }

    pub fn prometheus_with_limit(self: Snapshot, max_bytes: isize) -> Result[string, ExportError] {
        if max_bytes < 0 {
            return Result::Err(ExportError::Limit)
        }
        let output = text::StringBuilder::new();
        let used = Ref::new(0);
        self.emit_prometheus(
            |part| {
                if part.byte_len() > max_bytes - used.get() {
                    return Result::Err(ExportError::Limit)
                }
                output.write_string(part);
                used.set(used.get() + part.byte_len());
                Result::Ok(())
            },
        )?;
        Result::Ok(output.finish())
    }

    pub fn write_prometheus[W: Write](self: Snapshot, sink: W, max_bytes: isize) -> Result[
        isize,
        ExportError,
    ] {
        if max_bytes < 0 {
            return Result::Err(ExportError::Limit)
        }
        let used = Ref::new(0);
        self.emit_prometheus(
            |part| {
                if part.byte_len() > max_bytes - used.get() {
                    return Result::Err(ExportError::Limit)
                }
                sink.write_all(part.to_bytes().as_slice()).map_err(ExportError::Io)?;
                used.set(used.get() + part.byte_len());
                Result::Ok(())
            },
        )?;
        Result::Ok(used.get())
    }

    fn emit_prometheus(self: Snapshot, emit: (string) -> Result[(), ExportError]) -> Result[
        (),
        ExportError,
    ] {
        for family in self.families_value {
            let descriptor = family.descriptor;
            emit("# HELP " + descriptor.name + " " + escaped(descriptor.help, false) + "\n")?;
            emit(
                "# TYPE " + descriptor.name + " "
                    + match descriptor.kind {
                        Counter => "counter",
                        Gauge => "gauge",
                        Histogram => "histogram",
                    }
                    + "\n",
            )?;
            for sample in family.samples {
                let labels = sample_labels(sample.labels, Option::None);
                match sample.value {
                    Counter(value) => emit(
                        descriptor.name + labels + " " + value.to_string() + "\n",
                    )?,
                    Gauge(value) => emit(descriptor.name + labels + " " + number(value) + "\n")?,
                    Histogram(value) => {
                        for index in 0..value.boundaries.len() {
                            emit(
                                descriptor.name + "_bucket"
                                    + sample_labels(
                                        sample.labels,
                                        Option::Some(number(value.boundaries[index])),
                                    )
                                    + " "
                                    + value.cumulative[index].to_string()
                                    + "\n",
                            )?;
                        }
                        emit(
                            descriptor.name + "_bucket"
                                + sample_labels(sample.labels, Option::Some("+Inf"))
                                + " "
                                + value.count.to_string()
                                + "\n",
                        )?;
                        emit(descriptor.name + "_sum" + labels + " " + number(value.sum) + "\n")?;
                        emit(
                            descriptor.name + "_count" + labels + " " + value.count.to_string()
                                + "\n",
                        )?;
                    },
                }
            }
        }
        Result::Ok(())
    }
}
